---
// Small line icons (from the open-source Lucide set), drawn inline so they
// follow the text colour. Usage: <Icon name="map-pin" />
// To make a new icon available, import it below and add it to the list.
import anvil from 'lucide-static/icons/anvil.svg?raw';
import amphora from 'lucide-static/icons/amphora.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import axe from 'lucide-static/icons/axe.svg?raw';
import calendarCheck from 'lucide-static/icons/calendar-check.svg?raw';
import camera from 'lucide-static/icons/camera.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import circuitBoard from 'lucide-static/icons/circuit-board.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import cog from 'lucide-static/icons/cog.svg?raw';
import copy from 'lucide-static/icons/copy.svg?raw';
import drill from 'lucide-static/icons/drill.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import flag from 'lucide-static/icons/flag.svg?raw';
import graduationCap from 'lucide-static/icons/graduation-cap.svg?raw';
import handHelping from 'lucide-static/icons/hand-helping.svg?raw';
import info from 'lucide-static/icons/info.svg?raw';
import keyRound from 'lucide-static/icons/key-round.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import link from 'lucide-static/icons/link.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import map from 'lucide-static/icons/map.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import pencil from 'lucide-static/icons/pencil.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import rectangleGoggles from 'lucide-static/icons/rectangle-goggles.svg?raw';
import recycle from 'lucide-static/icons/recycle.svg?raw';
import rocket from 'lucide-static/icons/rocket.svg?raw';
import scan from 'lucide-static/icons/scan.svg?raw';
import scissors from 'lucide-static/icons/scissors.svg?raw';
import search from 'lucide-static/icons/search.svg?raw';
import send from 'lucide-static/icons/send.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import sprayCan from 'lucide-static/icons/spray-can.svg?raw';
import triangleAlert from 'lucide-static/icons/triangle-alert.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import warehouse from 'lucide-static/icons/warehouse.svg?raw';
import wrench from 'lucide-static/icons/wrench.svg?raw';
import zap from 'lucide-static/icons/zap.svg?raw';

const icons: Record<string, string> = {
  // interface
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  'calendar-check': calendarCheck,
  check,
  clock,
  copy,
  'file-text': fileText,
  flag,
  'hand-helping': handHelping,
  info,
  key: keyRound,
  link,
  mail,
  map,
  'map-pin': mapPin,
  pencil,
  plus,
  search,
  send,
  alert: triangleAlert,
  // the five kinds of pages
  spaces: warehouse,
  equipment: cog,
  skills: graduationCap,
  people: users,
  projects: rocket,
  // skills (the names listed as ICONS in src/forms/vocab.mjs)
  'printer-3d': layers,
  laser: zap,
  cnc: drill,
  wood: axe,
  metal: anvil,
  electronics: circuitBoard,
  scan,
  xr: rectangleGoggles,
  textile: scissors,
  plastic: recycle,
  paint: sprayCan,
  ceramics: amphora,
  camera,
  tools: wrench,
  spark: sparkles,
};

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const raw = icons[name] ?? icons.spark;
// Keep only the drawing itself; we write our own <svg> tag around it.
const inner = raw.replace(/<!--[\s\S]*?-->/g, '').replace(/<svg[\s\S]*?>/, '').replace('</svg>', '');
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
