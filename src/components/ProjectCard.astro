---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getData, entryUrl, type Project } from '../lib/data';

interface Props { project: Project }
const { project } = Astro.props;
const d = project.data;
const data = await getData();
const skills = data.pick(data.index.skills, d.skills);
const by = [...data.pick(data.index.people, d.makers).map((p) => p.data.title), d.credit].filter(Boolean).join(', ');
---

<article class="card t-projects">
  {
    d.image ? (
      <div class="card-media">
        <Image src={d.image} alt="" width={640} height={400} fit="cover" loading="lazy" />
      </div>
    ) : (
      <div class="card-media placeholder"><span>/* no photo yet */</span></div>
    )
  }
  <div class="card-body">
    {d.year && <div class="tokens"><span class="tok">{d.year}</span></div>}
    <h3><a href={entryUrl(project)}>{d.title}</a></h3>
    {d.summary && <p class="clamp-3">{d.summary}</p>}
    {by && <span class="meta"><Icon name="people" size={15} /> <span>{by}</span></span>}
    {skills.length > 0 && <ul class="chips">{skills.slice(0, 4).map((s) => <li class="chip chip-skills">{s.data.title}</li>)}</ul>}
  </div>
</article>
